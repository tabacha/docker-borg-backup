# Vorlage für EINEN Zielserver - kopieren zu targets/<name>.env, mit echten
# Werten füllen, NICHT committen (targets/*.env ist in .gitignore, targets/
# *.env.example bleibt getrackt):
#   cp targets/example.env.example targets/hetzner1.env
#
# <name> ist der Bezeichner, mit dem alle Skripte diesen Zielserver
# ansprechen: backup.sh <name>, admin-compact.sh <name>, admin-shell.sh
# <name>, disaster-recovery-info.sh <name>, setup-secrets.sh <name>. Für
# mehrere unabhängige Zielserver (z.B. wechselnd erreichbare Rechner bei
# verschiedenen Admins) einfach mehrere targets/<name>.env anlegen - jeder
# Zielserver braucht außerdem eigene Secrets unter secrets/<name>/ (siehe
# setup-secrets.sh, README.md).
#
# Diese Datei ist die EINZIGE Konfigurationsquelle für den Zielserver -
# es gibt kein zusätzliches globales .env mehr. Sichert derselbe Host
# dieselben Pfade zu mehreren Zielservern, wiederholen sich Werte wie
# BACKUP_SOURCE_DIRS zwangsläufig in mehreren targets/*.env - das ist so
# gewollt: jede Datei ist für sich vollständig, "cp"/"mv" genügt.

# Zugangsdaten zum Borg-Repo dieses Zielservers (z.B. eine Hetzner Storage
# Box, oder ein Admin-Rechner zuhause).
BORG_SSH_USER=u000000
BORG_SSH_HOST=u000000.your-storagebox.de
BORG_SSH_PORT=23
BORG_REPO_PATH=./borg-backup
BORG_REMOTE_PATH=borg-1.4

# Präfix für Archivnamen (::<prefix>-<zeitstempel>), auch für den
# --glob-archives Filter beim Prune in admin-compact.sh. Muss nur innerhalb
# dieses Zielservers eindeutig sein.
ARCHIVE_PREFIX=change-me

# Host-Verzeichnis(se), die zu DIESEM Zielserver gesichert werden
# (-> /source/<lfd. Nummer> im Container). Mehrere unabhängige
# Verzeichnisbäume ohne gemeinsames Elternverzeichnis durch Leerzeichen
# getrennt angeben (Pfade selbst dürfen daher keine Leerzeichen enthalten),
# z.B.:
#   BACKUP_SOURCE_DIRS="/etc /usr/local/share/rocketchat /srv"
BACKUP_SOURCE_DIRS=/backup

# Zusätzliche Argumente für "borg create", optional (z.B. --exclude-caches,
# --numeric-owner, --noatime, eine andere --compression). Wie bei
# PRUNE_RETENTION unten einfache, leerzeichengetrennte Flags ohne
# Anführungszeichen/Glob-Sonderzeichen - die werden vom Backup-Host-Shell
# selbst ausgewertet, bevor sie im Container ankommen. Auskommentiert/leer
# lassen übernimmt das heutige Verhalten unverändert:
# BORG_CREATE_EXTRA_ARGS="--exclude-caches --numeric-owner --noatime"

# Befehl, der auf DIESEM Host vor "borg create" ausgeführt wird (z.B. ein
# Skript mit "mongodump" vor dem Sichern einer laufenden MongoDB/
# Rocket.Chat-Instanz). Läuft mit denselben Rechten wie backup.sh selbst
# (üblicherweise root via Cron), NICHT im Borg-Container. Schlägt der
# Befehl fehl (Exit != 0), wird der Lauf abgebrochen, OHNE "borg create"
# aufzurufen. Optional, leer lassen deaktiviert den Hook:
# PRE_BACKUP_HOOK="/pfad/zum/host/pre-backup-hook.sh"

# Retention für "borg prune" in admin-compact.sh, optional. Auskommentiert
# lassen übernimmt den Default im Skript (--keep-within 2d --keep-daily 7
# --keep-weekly 3 --keep-monthly 12 --keep-yearly 2):
# PRUNE_RETENTION="--keep-within 2d --keep-daily 7 --keep-weekly 3 --keep-monthly 12 --keep-yearly 2"

# Uptime-Kuma-Push-Monitor (https://<instanz>/api/push/<token>) für DIESEN
# Zielserver, optional - pro Zielserver ein eigener Monitor sinnvoll, weil
# jeder Zielserver unabhängig ausfallen kann. Leer lassen bzw. Zeilen
# löschen, um den Push komplett zu deaktivieren - ohne alle drei Variablen
# wird kein Request gemacht, weder bei backup.sh noch bei admin-compact.sh.
UPTIME_KUMA_BASE_URL=https://uptime.example.org
UPTIME_KUMA_BACKUP_TOKEN=change-me
UPTIME_KUMA_COMPACT_TOKEN=change-me
