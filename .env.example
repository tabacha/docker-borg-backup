# Vorlage für .env - kopieren, mit echten Werten füllen, NICHT committen:
#   cp .env.example .env
#
# Zusätzlich müssen in secrets/ liegen (siehe README.md):
#   backup_ed25519 (+ .pub), known_hosts, passphrase

# Host-Verzeichnis, das gesichert wird (-> /source im Container).
BACKUP_SOURCE_DIR=/backup

# Zugangsdaten zum Borg-Repo (z.B. Hetzner Storage Box).
BORG_SSH_USER=u000000
BORG_SSH_HOST=u000000.your-storagebox.de
BORG_SSH_PORT=23
BORG_REPO_PATH=./borg-backup
BORG_REMOTE_PATH=borg-1.4

# Präfix für Archivnamen (::<prefix>-<zeitstempel>), auch für den
# --glob-archives Filter beim Prune in admin-compact.sh.
ARCHIVE_PREFIX=change-me

# Uptime-Kuma-Push-Monitore (https://<instanz>/api/push/<token>), optional.
# Leer lassen bzw. Zeilen löschen, um den Push komplett zu deaktivieren -
# ohne beide Variablen (BASE_URL + der jeweilige Token) wird kein Request
# gemacht, weder bei backup.sh noch bei admin-compact.sh.
UPTIME_KUMA_BASE_URL=https://uptime.example.org
UPTIME_KUMA_BACKUP_TOKEN=change-me
UPTIME_KUMA_COMPACT_TOKEN=change-me
